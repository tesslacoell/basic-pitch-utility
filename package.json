{
  "name": "basic-pitch-midi",
  "private": true,
  "version": "1.0.0-beta.3",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "vite --port=3000 --host=0.0.0.0",
    "server:standalone": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "electron": "vite build && electron electron/main.cjs",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:build": "vite build && electron-builder",
    "toolkit:build": "node scripts/build.mjs",
    "toolkit:run": "node scripts/build.mjs --run",
    "toolkit:web": "node scripts/build.mjs --web"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^3.21.0",
    "@tonejs/midi": "^2.0.28",
    "@types/jszip": "^3.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "onnxruntime-node": "1.31.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.spotify.basicpitch.desktop",
    "productName": "Basic Pitch MIDI",
    "publish": null,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "x64ArchFiles": "**/onnxruntime-node/**",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "@google/genai": true,
    "core-js": true,
    "electron-winstaller": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.31.1": true,
    "protobufjs": true
  }
}
